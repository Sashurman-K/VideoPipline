# ==============================================================================
# JWT Authentication & Security Settings
# ==============================================================================

# Секретный ключ для подписи JWT (HMAC-SHA256/512).
# Должен быть длинной не менее 32 байт (256 бит) для HMAC-SHA256 или 64 байт для HMAC-SHA512.
JWT_SECRET_KEY=super_secret_jwt_key_example_change_me_in_production_32bytes_min

# Время жизни Access-токена в миллисекундах (86400000 ms = 24 часа)
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# Optional Refresh Token Settings (при наличии)
# ==============================================================================
# Время жизни Refresh-токена в миллисекундах (604800000 ms = 7 дней)
# JWT_REFRESH_EXPIRATION_MS=604800000