# ==============================================================================
# Server Configuration
# ==============================================================================
APP_PORT=8080

# ==============================================================================
# PostgreSQL Database Settings
# ==============================================================================
# Для Docker Compose — имя контейнера базы (postgres-user)
# Для запуска из IDE — localhost (и внешний порт из ports.env, например 5432)
DB_HOST=postgres-user
POSTGRES_PORT=5432
POSTGRES_DB=user_db
POSTGRES_USER=user
POSTGRES_PASS=password

