# Single source of deployment values. Never commit .env.
# Host ports; container HTTP ports remain 8080.
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
UPLOAD_SERVICE_PORT=8083
SPLITTER_SERVICE_PORT=8084
POSTGRES_USER_PORT=5432
POSTGRES_UPLOAD_PORT=5433
KAFKA_PORT=29092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_UI_PORT=8082
CLOUDBEAVER_PORT=8978

# Database credentials (shared with the corresponding PostgreSQL container).
USER_DB_NAME=user_db
USER_DB_USER=user
USER_DB_PASSWORD=password
UPLOAD_DB_NAME=upload_db
UPLOAD_DB_USER=upload_user
UPLOAD_DB_PASSWORD=upload_pass

JWT_SECRET_KEY=dev_super_secret_key_32_bytes_minimum_length!
JWT_EXPIRATION_MS=86400000

# Shared Kafka contracts; group IDs belong to individual consumers.
KAFKA_UPLOAD_TOPIC_NAME=video-upload-event-topic
KAFKA_PROCESSING_TOPIC_NAME=video-processing-event-topic
KAFKA_FINAL_TOPIC_NAME=video-final-event-topic
KAFKA_SPLITTER_GROUP_ID=splitter-group
KAFKA_UPLOAD_GROUP_ID=upload-group
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICAS=1
KAFKA_TOPIC_MIN_ISR=1

# S3 is external to this Compose stack. Set a reachable endpoint and credentials.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_RAW_BUCKET_NAME=raw-videos
AWS_PROCESSED_BUCKET_NAME=processed-videos
AWS_ENDPOINT=http://host.docker.internal:9000

# AI service is not included in this Compose stack.
AI_SERVICE_URL=http://ai-service:8080
